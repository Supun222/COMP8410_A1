# Hugging Face & Torch cache directories
.cache/
huggingface/
checkpoints/

# Heavy 3D mesh outputs (Keep lightweight sample renders/JSONs, ignore huge meshes)
*.obj
*.glb
*.gltf
*.ply
*.stl

# Heavy video outputs (Track test scripts and frames, ignore large raw render dumps)
*.mp4
*.avi
*.mov
*.mkv

